# --- Firebase web config (public — safe to expose to the browser) ---
# From: Firebase Console > Project settings > General > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# --- Gemini via Vertex AI ---
# No API key needed. Auth is via Application Default Credentials — on
# Cloud Run this is the service's own service account automatically.
# GCP_PROJECT defaults to FIREBASE_PROJECT_ID if unset (same project).
GCP_PROJECT=
GCP_LOCATION=us-central1

# --- Local-only: Application Default Credentials ---
# On Cloud Run, ADC works automatically via the attached service account —
# nothing to configure. For local testing only, authenticate your own
# gcloud identity instead of downloading a key file:
#   gcloud auth application-default login
